{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazel.example/schemas/change-manifest.schema.json",
  "title": "Hazel change manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_id",
    "change_id",
    "change_type",
    "base_commit",
    "approval",
    "allowed_files",
    "allowed_sections",
    "requirements",
    "protected_elements",
    "permissions",
    "required_reviewers"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "meeting_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "change_id": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" },
    "change_type": { "enum": ["content", "functional", "ui", "mixed", "no_change"] },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "approved_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "approved_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "allowed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_sections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence_ids", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "protected_elements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "root_css_variables",
          "font_imports",
          "font_families",
          "brand_assets",
          "page_shell",
          "unrelated_sections",
          "open_questions",
          "approvals",
          "decision_history"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_global_styles", "allow_brand_assets", "allow_page_shell"],
      "properties": {
        "allow_global_styles": { "type": "boolean" },
        "allow_brand_assets": { "type": "boolean" },
        "allow_page_shell": { "type": "boolean" }
      }
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["Vantage", "Theorem"] }
    },
    "no_change_reason": { "type": ["string", "null"] }
  }
}
