{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazel.example/schemas/meeting-delta.schema.json",
  "title": "Hazel meeting delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration_id",
    "status",
    "source",
    "decisions",
    "approved_changes",
    "requested_changes",
    "action_items",
    "open_questions",
    "superseded_decisions",
    "final_takeaways",
    "implementation_recommended"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "iteration_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "status": { "enum": ["ready", "blocked", "no_change"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_path", "meeting_date", "content_sha256"],
      "properties": {
        "transcript_path": { "type": "string", "minLength": 1 },
        "meeting_date": { "type": "string", "format": "date" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "approved_changes": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "requested_changes": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "owner", "due_date"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidence" },
          "owner": { "type": "string", "minLength": 1 },
          "due_date": {
            "oneOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "const": "unknown" }
            ]
          }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "superseded_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "supersedes_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidence" },
          "supersedes_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "final_takeaways": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 7
    },
    "implementation_recommended": { "type": "boolean" },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "excerpt"],
        "properties": {
          "location": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
