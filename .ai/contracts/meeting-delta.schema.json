{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazel.example/schemas/meeting-delta.schema.json",
  "title": "Hazel meeting delta",
  "description": "Candidates extracted from one source. NOTHING HERE IS AUTHORITATIVE. Items become records only after librarian approval, at which point they are written to 04-ledger/decisions/ or questions/ under their own contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_id",
    "status",
    "source",
    "decisions",
    "approved_changes",
    "requested_changes",
    "action_items",
    "open_questions",
    "superseded_decisions",
    "not_promoted",
    "final_takeaways",
    "implementation_recommended"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "meeting_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "status": { "enum": ["ready", "blocked", "no_change"] },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_path", "meeting_date", "content_sha256"],
      "properties": {
        "transcript_path": { "type": "string", "minLength": 1 },
        "meeting_date": { "type": "string", "format": "date" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "decisions": { "type": "array", "items": { "$ref": "#/$defs/candidateDecision" } },
    "approved_changes": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "requested_changes": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },

    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "owner", "due_date"],
        "properties": {
          "id": { "type": "string", "pattern": "^ACT-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidence" },
          "owner": { "type": "string", "minLength": 1 },
          "due_date": {
            "oneOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "const": "unknown" }
            ]
          }
        }
      }
    },

    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/candidateQuestion" } },

    "superseded_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "supersedes_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAND-DEC-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidence" },
          "supersedes_id": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" }
        }
      }
    },

    "not_promoted": {
      "type": "array",
      "description": "Things the extractor deliberately did NOT propose, and why. Makes the librarian's review auditable: they can see what was discarded, not only what was suggested. An empty array asserts that nothing was discarded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "evidence", "reason"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidence" },
          "reason": {
            "enum": [
              "withdrawn_by_speaker",
              "explicitly_parked",
              "no_agreement_reached",
              "restates_existing_record",
              "speculation_without_commitment",
              "out_of_scope"
            ]
          },
          "note": { "type": "string", "maxLength": 1200 }
        }
      }
    },

    "final_takeaways": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 7
    },
    "implementation_recommended": { "type": "boolean" },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },

  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },

    "candidateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "statement", "evidence", "owner", "confidence", "routing"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAND-DEC-[0-9]{3,}$",
          "description": "Candidate id, local to this delta. A real DEC- id is issued only on approval."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Named authority who made the call, or the literal string unknown. Never inferred."
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "confidence_note": {
          "type": "string",
          "maxLength": 1200,
          "description": "Required when confidence is medium or low. Say what is uncertain."
        },
        "routing": {
          "type": "array",
          "minItems": 1,
          "description": "PROPOSED routing. The librarian confirms or corrects it at approval.",
          "items": { "$ref": "#/$defs/route" }
        },
        "supersedes_id": {
          "type": "string",
          "pattern": "^DEC-[0-9]{3,}$",
          "description": "Present when this candidate reverses an existing record."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "confidence": { "enum": ["medium", "low"] } } },
          "then": { "required": ["confidence_note"] }
        }
      ]
    },

    "candidateQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "question", "evidence", "owner", "due_date", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^CAND-Q-[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "question": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "owner": { "type": "string", "minLength": 1 },
        "due_date": {
          "oneOf": [
            { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            { "const": "unknown" }
          ]
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "confidence_note": { "type": "string", "maxLength": 1200 },
        "blocking": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "routing": {
          "type": "array",
          "items": { "$ref": "#/$defs/route" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "confidence": { "enum": ["medium", "low"] } } },
          "then": { "required": ["confidence_note"] }
        }
      ]
    },

    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "area"],
      "properties": {
        "repo": {
          "enum": [
            "hop-frontend-demo",
            "react-frontend",
            "wf-orchestration",
            "integration-wrapper",
            "hazel-kb",
            "none"
          ]
        },
        "area": { "type": "string", "minLength": 1 }
      }
    },

    "confidence": {
      "enum": ["high", "medium", "low"],
      "description": "high: explicit agreement or a named authority deciding. medium: the substance is clear but an attribute is not. low: arguably a decision, arguably not — the librarian should look closely."
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "excerpt"],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(t:[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?|s:.+|l:[0-9]+(-[0-9]+)?)$"
          },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
