{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazel.example/schemas/verification-report.schema.json",
  "title": "Hazel verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration_id",
    "change_id",
    "base_commit",
    "candidate_commit",
    "checks",
    "changed_files",
    "changed_sections",
    "visual_review",
    "disposition"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "iteration_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "change_id": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "details"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "changed_sections": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "viewports", "evidence"],
      "properties": {
        "status": { "enum": ["pass", "fail", "pending", "blocked"] },
        "reviewer": { "type": ["string", "null"] },
        "viewports": {
          "type": "array",
          "items": { "enum": ["desktop", "mobile"] }
        },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "disposition": { "enum": ["pass", "fail", "blocked"] }
  }
}
