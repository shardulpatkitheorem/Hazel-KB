{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazel.example/schemas/open-question.schema.json",
  "title": "Hazel open question",
  "description": "An unresolved question with a named owner. Distinct from a decision: a question records that something is NOT settled. Questions remain visible after they are answered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "question",
    "status",
    "owner",
    "raised_on",
    "recorded_on",
    "origin",
    "evidence",
    "blocking",
    "answer"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },

    "id": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },

    "title": { "type": "string", "minLength": 1, "maxLength": 120 },

    "question": {
      "type": "string",
      "minLength": 1,
      "description": "The question as posed. Immutable; if the question changes, raise a new one."
    },

    "status": { "enum": ["open", "blocked", "answered"] },

    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Named individual, or the literal string unknown. Never a team name."
    },

    "raised_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recorded_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },

    "due_date": {
      "description": "Optional. Present only when a date was explicitly committed. Never inferred.",
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "const": "unknown" }
      ]
    },

    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "meeting_id", "transcript_path", "meeting_date", "content_sha256"],
          "properties": {
            "kind": { "const": "meeting" },
            "meeting_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
            "transcript_path": { "type": "string", "minLength": 1 },
            "meeting_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document_path", "content_sha256"],
          "properties": {
            "kind": { "const": "document" },
            "document_path": { "type": "string", "minLength": 1 },
            "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rationale", "raised_by"],
          "properties": {
            "kind": { "const": "internal" },
            "rationale": { "type": "string", "minLength": 1 },
            "raised_by": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "excerpt"],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(t:[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?|s:.+|l:[0-9]+(-[0-9]+)?)$"
          },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },

    "blocking": {
      "type": "array",
      "description": "Decisions or changes this question blocks. Empty array means it blocks nothing.",
      "items": { "type": "string", "minLength": 1 }
    },

    "routing": {
      "type": "array",
      "description": "Optional. Present when the question is known to concern a specific repository and area.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "area"],
        "properties": {
          "repo": {
            "enum": [
              "react-frontend",
              "wf-orchestration",
              "integration-wrapper",
              "hazel-kb",
              "none"
            ]
          },
          "area": { "type": "string", "minLength": 1 }
        }
      }
    },

    "answer": {
      "description": "Null until answered. When answered, cites the resolving decision or evidence.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["answered_on", "resolved_by", "summary"],
          "properties": {
            "answered_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "resolved_by": {
              "type": "string",
              "minLength": 1,
              "description": "Decision ID, iteration ID, or PR URL that resolves this."
            },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
